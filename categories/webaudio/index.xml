			<item>
				<title>JavaScript版WaveZutaZuta作ってみた</title>
				<link>https://shogo82148.github.io/blog/2012/12/24/wavezutazutajs/</link>
				<pubDate>Mon, 24 Dec 2012 13:51:00 +0900</pubDate>
